{
  "name": "pocket-pos",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Offline-first point-of-sale for phones. Web/PWA first, packaged as an Android APK with Capacitor.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "android:sync": "npm run build && cap sync android",
    "apk": "bash scripts/build-apk.sh"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@preact/signals": "^2.11.3",
    "idb": "^8.0.3",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@preact/preset-vite": "^2.10.6",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
